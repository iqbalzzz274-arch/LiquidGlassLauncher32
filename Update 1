steps:
  - name: Checkout
    uses: actions/checkout@v4

  - name: Find and extract project ZIP
    run: |
      ZIP=$(find . -maxdepth 2 -type f -name 'VoidGlassLauncherPremium_RedmiA3*.zip' | head -n 1)
      test -n "$ZIP"
      rm -rf build_project
      mkdir build_project
      unzip -q "$ZIP" -d build_project
      ROOT=$(find build_project -mindepth 1 -maxdepth 1 -type d | head -n 1)
      test -n "$ROOT"
      cp -r "$ROOT"/. build_project/
      rm -rf "$ROOT"

  - name: Set up Java 17
    uses: actions/setup-java@v4
    with:
      distribution: temurin
      java-version: '17'

  - name: Set up Gradle
    uses: gradle/actions/setup-gradle@v4
    with:
      gradle-version: '8.7'

  - name: Build APK
    working-directory: build_project
    run: gradle --no-daemon assembleDebug

  - name: Upload APK
    uses: actions/upload-artifact@v4
    with:
      name: VoidGlassLauncher-debug
      path: build_project/app/build/outputs/apk/debug/*.apk
